# Base URL digunakan oleh Axios (src/lib/axios.ts).
# Di development, request lewat Vite proxy (lihat vite.config.ts).
#
# CATATAN DEPLOY VERCEL:
# Di Vercel, pakai URL ABSOLUT ke API (bukan relatif), karena domain
# berbeda dari frontend. Contoh:
#   VITE_API_BASE_URL=https://executrain-api.vercel.app/api/v2
VITE_API_BASE_URL=/api/v2
